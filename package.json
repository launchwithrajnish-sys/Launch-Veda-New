		"Edge >= 109",
		"Firefox >= 109",
		"Safari >= 16.4",
		"iOS >= 16.4"
	],
	"dependencies": {
		"gsap": "^3.15.0",
		"lucide-react": "^0.546.0",
		"motion": "^12.23.24",
		"next": "^16.2.9",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"resend": "^6.17.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.1",
		"@types/node": "^22.14.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"autoprefixer": "^10.4.21",
		"cross-env": "^10.1.0",
		"postcss": "^8.5.15",
		"tailwindcss": "^4.1.14",
		"tsx": "^4.22.4",
		"typescript": "~5.8.2"
