{
	"name": "react-example",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "node dev-server.js",
		"build": "cross-env NODE_ENV=production next build && npm run sitemap",
		"start": "next start -p 3000 -H 0.0.0.0",
		"sitemap": "tsx scripts/generate-sitemap.ts",
		"lint": "tsc --noEmit"
